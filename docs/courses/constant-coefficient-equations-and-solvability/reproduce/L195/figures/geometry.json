{
  "primitive": {
    "spatial_support": "x1>=0,x2=0",
    "interior_mark": [
      "1",
      "0"
    ],
    "endpoint_covectors": "all nonzero pairs;unit section is the full circle",
    "interior_covectors": "xi1=0,xi2!=0;unit section consists of(0,1),(0,-1)",
    "reciprocal": "i*zeta1",
    "identity": "Phi*mu_hat=1 distributionally",
    "characteristic_set": "empty"
  },
  "root_reciprocal": {
    "domain": "abs(Im(zeta))<abs(Re(zeta))/2,abs(zeta)>2",
    "branch_points": [
      [
        "0",
        "1"
      ],
      [
        "0",
        "-1"
      ]
    ],
    "disk_centers": [
      "-6",
      "-3",
      "3",
      "6"
    ],
    "disk_radii": [
      "3/2",
      "3/4",
      "3/4",
      "3/2"
    ],
    "S": "exp(log(1+zeta^(-2))/2)",
    "branches": {
      "positive": "zeta*S",
      "negative": "-zeta*S"
    },
    "norm_bounds": [
      "sqrt(3)*abs(zeta)/2",
      "sqrt(5)*abs(zeta)/2"
    ]
  },
  "real_plot": {
    "range": [
      "0",
      "4"
    ],
    "curves": [
      "log(1+xi^2)/2",
      "xi^2"
    ],
    "upper_bound": "log(sqrt(5)/2)+log(xi),xi>=2"
  },
  "scope": "Spatial and cotangent panels have separate axes;complex regions are exact chosen domains and curves are numerical evaluations of the stated functions."
}
